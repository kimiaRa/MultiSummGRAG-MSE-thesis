  <data key="d0">"EVENT"</data>
  <data key="d1">"Environmental Benefits are a result of edible gardens, contributing to urban greening, biodiversity, and sustainable practices like composting."</data>
  <data key="d2">chunk-793ca07a4fd1a42f1e0f5955223694db</data>
  <data key="d3">[{"level": 0, "cluster": 38}, {"level": 1, "cluster": 140}]</data>
