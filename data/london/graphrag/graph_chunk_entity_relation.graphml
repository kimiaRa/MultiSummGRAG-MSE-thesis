  <data key="d0">"PERSON"</data>
  <data key="d1">"Sam Rudy is a member of the London Freedom Seed Bank steering group who visited Aleka Haziak in the Basque Country to learn about seed preservation practices."</data>
  <data key="d2">chunk-af4130ead67b8862fd5cd6ef12ca876b</data>
  <data key="d3">[{"level": 0, "cluster": 4}, {"level": 1, "cluster": 59}, {"level": 2, "cluster": 170}]</data>
</node>
